  "dialogue": [
    {"start":3.4,"end":9.7,"speaker":"손녀","text":"할머니, 토요일에 나 발표회 해.\n끝나고 나랑 사진 찍어야 해!","rate":190},
    {"start":10.5,"end":13.8,"speaker":"어머니","text":"그래. 할머니도 갈게.","rate":164},
    {"start":14.5,"end":17.6,"speaker":"아들","text":"토요일에 데리러 올게.","rate":181},
    {"start":18.5,"end":23.6,"speaker":"어머니","text":"거기… 차 세우고\n많이 걸어야 하니?","rate":157},
    {"start":24.8,"end":30.4,"speaker":"아들","text":"엄마, 잠깐만.\n다른 입구 찾아볼게.","rate":175},
    {"start":34,"end":39.5,"speaker":"어머니","text":"너 번거로우면,\n영상으로 봐도 돼.","rate":158},
    {"start":41,"end":46.8,"speaker":"아들","text":"오늘은 엄마랑 같이 갈 길을\n미리 보고 가자.","rate":178},
    {"start":48,"end":54.2,"speaker":"아들","text":"계단 없는 길로,\n차에서 내려서 같이 가는 거야.","rate":178},
    {"start":56,"end":61.5,"speaker":"어머니","text":"계단만 없으면\n천천히 걸어갈 수 있어.","rate":163},
    {"start":63.5,"end":70.6,"speaker":"아들","text":"여기 세우면 우리 같이 내리면 돼.\n후문까지 같이 걸어가면 되고.","rate":179},
    {"start":73.6,"end":77.5,"speaker":"어머니","text":"그래, 같이 가자.","rate":166},
    {"start":99,"end":103,"speaker":"문앞 · 임시 음성","text":"후문 주차 구역에 주차했나요?","rate":182},
    {"start":107,"end":113.5,"speaker":"문앞 · 임시 음성","text":"입구 안내를\n휴대폰에서 이어볼 수 있어요.","rate":180},
    {"start":122.4,"end":126.5,"speaker":"어머니","text":"저 파란 안내판 쪽이지?","rate":166},
    {"start":127.1,"end":129.7,"speaker":"아들","text":"응. 같이 가자.","rate":178},
    {"start":141,"end":145.9,"speaker":"손녀","text":"할머니, 여기 내 옆에 서!","rate":192},
    {"start":148,"end":152.5,"speaker":"어머니","text":"사진 찍기로 했잖아.","rate":163},
    {"start":165.1,"end":168.5,"speaker":"아들","text":"엄마, 바로 집에 갈까?","rate":180},
    {"start":169.3,"end":176.8,"speaker":"어머니","text":"온 김에… 다 같이 밥 먹고 가자.\n오늘은 내가 고를게.","rate":164}
